# Every variable this app reads. Copy to `.env.local` and fill in.
# Nothing here is a real value — see README.md → Environment for the detail.

# ---- AI (required) -----------------------------------------------------------

# The only credential the app cannot run without.
OPENROUTER_API_KEY=

# Optional. Defaults are applied in lib/ai/ai-config.ts.
OPENROUTER_MODEL=
OPENROUTER_MAX_OUTPUT_TOKENS=

# ---- Redis -------------------------------------------------------------------

# Required for share links, and what makes rate limiting real. Without it the
# limiter is a no-op outside production and fails closed inside it.
#
# Supply EITHER pair — both names are read. The Vercel Marketplace Upstash
# integration provisions the KV_* pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Eval CLI (optional) -----------------------------------------------------

# Where `scripts/eval.ts` sends its runs. Defaults to localhost:3000/api/plan.
PLAN_API_URL=
