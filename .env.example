# Every variable this app reads. Copy to `.env.local` and fill in.
# Nothing here is a real value — see README.md → Environment for the detail.

# ---- AI (required) -----------------------------------------------------------

# The only credential the app cannot run without.
OPENROUTER_API_KEY=

# Optional. Defaults are applied in lib/ai/ai-config.ts.
OPENROUTER_MODEL=
OPENROUTER_MAX_OUTPUT_TOKENS=

# ---- Redis -------------------------------------------------------------------

# Required for share links, and what makes rate limiting real. Without it the
# limiter is a no-op outside production and fails closed inside it.
#
# Supply EITHER pair — both names are read. The Vercel Marketplace Upstash
# integration provisions the KV_* pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Rautaki Kommandozentrale integration (optional) -------------------------

# Leave all three unset and the integration does not exist: /api/manifest and
# /api/run answer 503 and do nothing, rather than standing open unauthenticated.
#
# Two tokens, one per direction, so either can be rotated without touching the
# other. They must never hold the same value. Generate each with:
#   openssl rand -hex 32

# Proves an incoming call is the dashboard. Its RUN_TOKEN_PLAN is the same value.
DASHBOARD_TOKEN=
# Where finished briefs are delivered. Use the production alias, never a
# deployment URL — the latter changes every deploy and sits behind protection.
RAUTAKI_DASHBOARD_URL=
# Proves an outgoing delivery came from this app. The dashboard's APP_TOKEN_PLAN
# is the same value.
RAUTAKI_RESULTS_TOKEN=

# ---- Eval CLI (optional) -----------------------------------------------------

# Where `scripts/eval.ts` sends its runs. Defaults to localhost:3000/api/plan.
PLAN_API_URL=
