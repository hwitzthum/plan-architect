# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which holds no values and is the only record of what
# this app needs. The negation must come after `.env*`, or the wildcard wins and
# the file is silently untracked — the vercel CLI re-appends `.env*` on `link`,
# so re-check this after running it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp artifacts
/.playwright-mcp/

# eval runtime output (kept locally, not committed)
/eval/results/

# JetBrains IDE settings — machine-specific, not shared
/.idea/
